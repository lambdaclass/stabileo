{
	log {
		format console
		output stdout
		level INFO
		include http.log.access
	}
}

import /etc/caddy/sites.d/*.caddy

(headers) {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		X-Robots-Tag "{args[0]}"
		-Server
	}
}

(common) {
	encode zstd gzip
	import headers "{$ROBOTS_TAG}"

	handle /api/* {
		reverse_proxy 127.0.0.1:{$BACKEND_PORT:4100}
	}
}

{$APP_DOMAIN} {
	root * {$STABILEO_ROOT}/live/frontends/app
	import common

	# The sitemap and canonicals carry only the slashed form; /en must answer 301, not 200.
	@dirNoSlash {
		not path */
		file {path}/index.html
	}
	redir @dirNoSlash {path}/ 301

	@notFoundPage path_regexp ^/([a-z]{2}/)?404\.html$
	handle @notFoundPage {
		error 404
	}

	map {path} {english_twin} {
		~^/(?:es|pt|de|fr|tr)(/[^.]*[^./])/?$ "/en${1}"
		default ""
	}
	@notInThisLanguage {
		not vars {english_twin} ""
		not file {path}/index.html
		file {english_twin}/index.html
	}
	redir @notInThisLanguage {english_twin}/ 301

	@static path_regexp \.
	handle @static {
		@assets path /assets/* /research-wasm/builds/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@researchUnhashed {
			path /research-wasm/*
			not path /research-wasm/builds/*
		}
		header @researchUnhashed Cache-Control "no-cache"
		@html path *.html
		header @html Cache-Control "no-cache"
		file_server {
			precompressed br
		}
	}

	@spa path /app /app/* /demo /demo/
	handle @spa {
		header Cache-Control "no-cache"
		rewrite * /index.html
		file_server
	}

	# Links from before the language prefixes (/blog/x) are still drawn by the client router.
	@unprefixed file /en{path}/index.html
	handle @unprefixed {
		header Cache-Control "no-cache"
		rewrite * /index.html
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} {path}/index.html
		file_server {
			precompressed br
		}
	}

	handle_errors {
		encode zstd gzip
		import headers noindex
		@notFound expression {err.status_code} == 404
		handle @notFound {
			header Cache-Control "no-cache"
			try_files /{path.0}/404.html /404.html
			file_server {
				status 404
			}
		}
	}
}

{$ADMIN_DOMAIN} {
	root * {$STABILEO_ROOT}/live/frontends/admin
	import common

	@static path_regexp \.
	handle @static {
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html path *.html
		header @html Cache-Control "no-cache"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} /admin.html
		file_server
	}
}
