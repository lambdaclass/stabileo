{
	log {
		format console
		output stdout
		level INFO
		include http.log.access
	}
}

import /etc/caddy/sites.d/*.caddy

(common) {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
	# Snapshots (/@<commit>/, below) are never indexed: each page's canonical names the latest site.
	@notSnapshot not path /@*
	header @notSnapshot X-Robots-Tag "{$ROBOTS_TAG}"
	header /@* X-Robots-Tag "noindex"

	handle /api/* {
		reverse_proxy 127.0.0.1:{$BACKEND_PORT:4100}
	}
}

{$APP_DOMAIN} {
	root * {$STABILEO_ROOT}/live/frontends/app
	import common

	# The sitemap and canonicals carry only the slashed form; /en must answer 301, not 200.
	@dirNoSlash {
		not path */
		file {path}/index.html
	}
	redir @dirNoSlash {path}/ 301

	# Snapshots: the site as built at a commit, kept forever under /@<first 7 of the commit>/
	# (docs/DEPLOY.md "Snapshots"). Files never change once written, so they are cached for good;
	# a snapshot that does not exist is a plain 404, not cached. /@/ is the index (JSON).
	redir /@ /@/ 301
	handle /@/ {
		root * {$STABILEO_ROOT}/snapshots
		rewrite * /index.json
		header Cache-Control "no-cache"
		file_server
	}

	@snapshot path_regexp snap ^/@([0-9a-f]{7})(/.*)?$
	handle @snapshot {
		root * {$STABILEO_ROOT}/snapshots/{re.snap.1}
		route {
			@bare path_regexp ^/@[0-9a-f]{7}$
			redir @bare {path}/ 301
			@snapDirNoSlash {
				not path */
				file {re.snap.2}/index.html
			}
			redir @snapDirNoSlash {path}/ 301
			# A missing file is a 404, as on the plain site; only page addresses fall back to the app.
			@snapMissingFile {
				path_regexp \.[^/]*$
				not file {re.snap.2}
			}
			respond @snapMissingFile 404
			@found file {
				try_files {re.snap.2} {re.snap.2}/index.html /index.html
			}
			header @found Cache-Control "public, max-age=31536000, immutable"
			rewrite @found {file_match.relative}
			file_server
		}
	}

	@invalidSnapshot path /@*
	handle @invalidSnapshot {
		respond 404
	}

	@static path_regexp \.
	handle @static {
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html path *.html
		header @html Cache-Control "no-cache"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} {path}/index.html /index.html
		file_server
	}
}

{$ADMIN_DOMAIN} {
	root * {$STABILEO_ROOT}/live/frontends/admin
	import common

	@static path_regexp \.
	handle @static {
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html path *.html
		header @html Cache-Control "no-cache"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} /admin.html
		file_server
	}
}
