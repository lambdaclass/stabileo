{
  "name": "stabileo-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "wasm": "cd ../engine && wasm-pack build --target web --out-dir ../web/src/lib/wasm --no-opt",
    "test": "node scripts/test-all.mjs",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:slow": "playwright test --grep @slow",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:baseline": "node scripts/typecheck.mjs --write",
    "test:unit": "vitest run --project unit",
    "test:build": "vitest run --project build"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^25.5.0",
    "@types/three": "^0.182.0",
    "svelte": "^5.19.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "dxf-parser": "^1.1.2",
    "katex": "^0.16.28",
    "lz-string": "^1.5.0",
    "three": "^0.182.0",
    "three-mesh-bvh": "^0.9.9",
    "web-ifc": "^0.0.75",
    "xlsx": "^0.18.5"
  }
}
