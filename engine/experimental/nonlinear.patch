+                            match same(&input, max_iter, n_increments, modified) {
+                                Some(result) if result.converged => converged += 1,
+                                _ => other += 1,
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        assert!(converged >= 40 && other >= 40 && sparse >= 6, "{converged} converged, {other} not, {sparse} sparse");
