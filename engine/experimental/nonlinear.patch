+fn set_supports(u: &mut [f64], nf: usize, u_r_start: &[f64], du_support: &[f64], lambda: f64) {
+    for (r, (&u0, &du)) in u_r_start.iter().zip(du_support).enumerate() {
+        u[nf + r] = u0 + lambda * du;
+    }
+}
