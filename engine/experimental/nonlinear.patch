+    match method {
+        IterationMethod::Anderson { depth } if depth == 0 || depth > MAX_ANDERSON_DEPTH => {
+            Err(format!("Anderson acceleration needs a depth from 1 to {MAX_ANDERSON_DEPTH}"))
+        }
