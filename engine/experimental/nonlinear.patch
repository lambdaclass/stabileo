+            id, node_id, support_type: kind.into(), kx: None, ky: None, kz: None, dx: None, dz: None, dry: None, angle: None,
+        };
+        supports.insert("1".into(), support(1, 1, if far_support.is_some() { "pinned" } else { "fixed" }));
+        if let Some(kind) = far_support {
