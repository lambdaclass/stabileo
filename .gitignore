# Dependencies
node_modules/
# also match a symlinked node_modules (worktree dev setups)
node_modules

# Build output
web/dist/

# IDE / OS
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# Env
.env
.env.local
.dev.vars

# Claude internal
.claude/

# Rust / Wasm build artifacts
target/
engine/target/
engine/pkg/
web/src/lib/wasm/
# also match a symlinked wasm pkg (worktree setups)
web/src/lib/wasm

# Nix (root-level build symlinks only — anchored so source files like
# src/lib/engine/result-query.ts are not silently ignored)
/result
/result-*
.direnv/

# Local doc-sync automation state
.doc-sync-last-head
.doc-sync.log
.doc-sync.launchd.out
.doc-sync.launchd.err
.cache/
.vite/

# Playwright artifacts (traces, videos, HTML report). Baselines under
# web/e2e/__screenshots__/ ARE committed.

# Throwaway diagnostics. Three `__probe*.spec.ts` reached `feat/pro-concrete-h1` through a
# `git add -A` and would have run in a QA sweep: no assertions, `console.log` output, and one of
# them with a ten-minute timeout. `__screenshots__` above is the deliberate exception and stays.
web/e2e/__probe*.spec.ts

web/e2e/.artifacts/
web/e2e/.report/
web/test-results/
web/playwright-report/
# Playwright writes these at the repo root too when it is invoked from here.
test-results/
playwright-report/

# Throwaway build outputs used by the E2E hook-gating test
web/.dist-hookgate-off/
web/.dist-hookgate-on/

# Official CIRSOC / INPRES-CIRSOC PDFs. The structured Markdown conversion under
# docs/codes/CIRSOC/markdown/ IS tracked; the ~56 MB of source PDFs are not, so the
# repository stays clonable. docs/codes/CIRSOC/SOURCES.md records the SHA-256 of every
# source file so any conversion can be re-verified against the exact document used.
docs/codes/CIRSOC/*.pdf
